{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "coding-puzzles",
	"compatibility_date": "2026-11-10",

	"routes": [{ "pattern": "puzzles.maxlarsson.dev", "custom_domain": true }],
	"workers_dev": false,
	"preview_urls": true,

	"assets": {
		"directory": "./build",
		"not_found_handling": "404-page"
	}
}
